{
  "name": "@solisola/localization",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "check": "npm run check:keys && npm run check:hardcoded",
    "check:hardcoded": "tsx scripts/check-hardcoded-copy.ts",
    "check:hardcoded:all": "tsx scripts/check-hardcoded-copy.ts --all",
    "check:keys": "tsx scripts/check-key-parity.ts",
    "lint": "eslint --max-warnings 0 --ext=ts src scripts",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run check"
  },
  "dependencies": {
    "i18next": "26.3.6",
    "i18next-icu": "2.4.4",
    "intl-messageformat": "11.2.13",
    "react-i18next": "17.0.11"
  },
  "devDependencies": {
    "@babel/parser": "7.27.1",
    "@formatjs/icu-messageformat-parser": "3.5.16",
    "@types/jest": "29.5.14",
    "@types/react": "19.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.0.5",
    "tsx": "4.19.2",
    "typescript": "5.0.4"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
